# ==============================================================================
# .dockerignore - Docker Build Context Optimization
# Purplle Store Intelligence Challenge
#
# Specifies files and directories to exclude from the Docker build context.
# This reduces build time and final image size by not copying unnecessary files.
#
# Key Principle: Only include files needed at runtime in the build context
# ==============================================================================

# ==============================================================================
# Version Control & Git
# ==============================================================================
.git/
.gitignore
.gitattributes

# ==============================================================================
# Development & IDE
# ==============================================================================
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
.env
.env.local
.env.*.local

# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytype/
.mypy_cache/
.dmypy.json
dmypy.json

# ==============================================================================
# Testing & Pytest
# ==============================================================================
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/
tests/_runtime_pipeline/
.coverage
htmlcov/
.hypothesis/
*.cover
coverage.xml
*.log

# ==============================================================================
# Docker & Container
# ==============================================================================
Dockerfile.dev
docker-compose.dev.yml
