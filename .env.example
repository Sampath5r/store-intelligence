# ==============================================================================
# .env.example: Store Intelligence Docker Environment Configuration
# Purplle Store Intelligence Challenge
#
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# The .env file is loaded automatically by docker-compose and provides
# environment variable overrides for both services.
# ==============================================================================

# ==============================================================================
# Environment Mode
# ==============================================================================
# Values: development, staging, production
# - development: Hot reload enabled, verbose logging, CORS wide-open
# - staging: Hot reload disabled, standard logging, restricted CORS
# - production: All optimizations enabled, minimal logging, tight CORS
ENV=development

# ==============================================================================
# FastAPI Backend Configuration
# ==============================================================================

# Port for FastAPI service (exposed as localhost:API_PORT)
API_PORT=8000

# Host binding (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
API_HOST=0.0.0.0

# Logging level for API (CRITICAL, ERROR, WARNING, INFO, DEBUG)
API_LOG_LEVEL=INFO

# Number of Uvicorn worker processes (for production)
# - development: 1 (single process for debugging)
# - production: leave unset to auto-detect CPU cores
API_WORKERS=1

# ==============================================================================
# Streamlit Dashboard Configuration
# ==============================================================================

# Port for Streamlit service (exposed as localhost:DASHBOARD_PORT)
DASHBOARD_PORT=8501

# Base URL for API endpoint (used by dashboard to fetch data)
# - Development (local): http://localhost:8000 or http://api:8000
# - Production (docker): http://api:8000 (internal service name)
# - Production (cloud): https://api.example.com
API_BASE_URL=http://api:8000

# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_RUN_ON_SAVE=true

# ==============================================================================
# Data Directories
# ==============================================================================

# Base data directory (relative to docker-compose.yml location)
DATA_DIR=./data

# Subdirectories for specific data types
EVENTS_DIR=./data/events
OUTPUTS_DIR=./data/outputs
VIDEOS_DIR=./data/videos
LOGS_DIR=./data/logs

# ==============================================================================
# Docker Resource Limits (Optional)
# ==============================================================================

# FastAPI service CPU/memory limits
API_CPUS=2.0
API_MEMORY=2g

# Streamlit service CPU/memory limits
DASHBOARD_CPUS=1.0
DASHBOARD_MEMORY=1g

# ==============================================================================
# CORS Configuration (Cross-Origin Resource Sharing)
# ==============================================================================

# Allowed origins for API requests from dashboard/external clients
# - development: "*" (allow all)
# - production: "https://dashboard.example.com,https://api.example.com"
CORS_ORIGINS=["http://localhost:8501", "http://dashboard:8501"]

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log retention (JSON file logging driver)
LOG_MAX_SIZE=100m
LOG_MAX_FILE=10

# ==============================================================================
# Advanced Configuration (Optional)
# ==============================================================================

# Timezone for container timestamps (default: UTC)
TZ=UTC

# Python settings for container
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ==============================================================================
# Notes
# ==============================================================================
# 1. This file is loaded by docker-compose automatically.
#    No need to source it manually.
#
# 2. Variables can be overridden on command line:
#    API_PORT=9000 docker-compose up
#
# 3. For production, create a separate .env.prod file:
#    docker-compose --env-file .env.prod up -d
#
# 4. Never commit sensitive values (.env) to version control.
#    Add .env to .gitignore.
#
# 5. Reference: https://docs.docker.com/compose/env-file/
